# Phase 0B.1 — Development account. Apply from the DEV account.
name                    = "ai-tos-dev"
environment             = "dev"
region                  = "us-east-1"
dr_region               = "us-west-2"
account_id              = "REPLACE_WITH_DEV_ACCOUNT_ID"
shared_services_account_id = "REPLACE_WITH_SHARED_SERVICES_ACCOUNT_ID"
is_aggregator           = false
is_log_archive          = false
create_cloudtrail       = false   # org trail in Shared Services covers this account
access_analyzer_type    = "ACCOUNT"
org_id                  = "REPLACE_WITH_ORG_ID"
central_log_bucket_name = "ai-tos-shared-services-logs"
domain                  = "dev.ai-tos.example.com"
vpc_cidr                = "10.10.0.0/16"
public_subnets          = ["10.10.0.0/20", "10.10.16.0/20", "10.10.32.0/20"]
private_subnets         = ["10.10.64.0/20", "10.10.80.0/20", "10.10.96.0/20"]
database_subnets        = ["10.10.128.0/20", "10.10.144.0/20", "10.10.160.0/20"]
one_nat_gateway_per_az  = false
single_nat_gateway      = true    # cost-saving in dev
cross_account_external_id = "REPLACE_WITH_EXTERNAL_ID"
budget_amount           = 1000
budget_email            = "finops@ai-tos.example.com"
