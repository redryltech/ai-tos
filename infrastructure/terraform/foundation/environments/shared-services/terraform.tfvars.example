# Phase 0B.1 — Shared Services (Security / Logging / Central) account.
# Copy to terraform.tfvars and fill REPLACE_* values. Apply from the SHARED-SERVICES account.
name                    = "ai-tos-shared-services"
environment             = "shared-services"
region                  = "us-east-1"
dr_region               = "us-west-2"
account_id              = "REPLACE_WITH_SHARED_SERVICES_ACCOUNT_ID"
shared_services_account_id = "REPLACE_WITH_SHARED_SERVICES_ACCOUNT_ID"
is_aggregator           = true
is_log_archive          = true
create_cloudtrail       = true
access_analyzer_type    = "ORGANIZATION"
org_id                  = "REPLACE_WITH_ORG_ID"   # e.g. o-xxxxxxxxxx
domain                  = "ai-tos.example.com"
vpc_cidr                = "10.0.0.0/16"
public_subnets          = ["10.0.0.0/20", "10.0.16.0/20", "10.0.32.0/20"]
private_subnets         = ["10.0.64.0/20", "10.0.80.0/20", "10.0.96.0/20"]
database_subnets        = ["10.0.128.0/20", "10.0.144.0/20", "10.0.160.0/20"]
one_nat_gateway_per_az  = true
single_nat_gateway      = false
cross_account_external_id = "REPLACE_WITH_EXTERNAL_ID"
budget_amount           = 1500
budget_email            = "finops@ai-tos.example.com"
