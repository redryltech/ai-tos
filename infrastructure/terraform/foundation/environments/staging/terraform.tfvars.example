# Phase 0B.1 — Staging account. Apply from the STAGING account.
name                    = "ai-tos-staging"
environment             = "staging"
region                  = "us-east-1"
dr_region               = "us-west-2"
account_id              = "REPLACE_WITH_STAGING_ACCOUNT_ID"
shared_services_account_id = "REPLACE_WITH_SHARED_SERVICES_ACCOUNT_ID"
is_aggregator           = false
is_log_archive          = false
create_cloudtrail       = false
access_analyzer_type    = "ACCOUNT"
org_id                  = "REPLACE_WITH_ORG_ID"
central_log_bucket_name = "ai-tos-shared-services-logs"
domain                  = "staging.ai-tos.example.com"
vpc_cidr                = "10.20.0.0/16"
public_subnets          = ["10.20.0.0/20", "10.20.16.0/20", "10.20.32.0/20"]
private_subnets         = ["10.20.64.0/20", "10.20.80.0/20", "10.20.96.0/20"]
database_subnets        = ["10.20.128.0/20", "10.20.144.0/20", "10.20.160.0/20"]
one_nat_gateway_per_az  = false
single_nat_gateway      = true
cross_account_external_id = "REPLACE_WITH_EXTERNAL_ID"
budget_amount           = 1500
budget_email            = "finops@ai-tos.example.com"
