# Phase 0B.3 — Data platform (self-contained example). Apply in the target account.
# In production the data stack lives in each environment VPC (see foundation README); this
# standalone environment demonstrates VPC + KMS + RDS + Redis wiring and validates independently.
name                    = "ai-tos-prod"
environment             = "prod"
region                  = "us-east-1"
dr_region               = "us-west-2"
vpc_cidr                = "10.30.0.0/16"
public_subnets          = ["10.30.0.0/20", "10.30.16.0/20", "10.30.32.0/20"]
private_subnets         = ["10.30.64.0/20", "10.30.80.0/20", "10.30.96.0/20"]
database_subnet_ids     = ["10.30.128.0/20", "10.30.144.0/20", "10.30.160.0/20"]
one_nat_gateway_per_az  = true
single_nat_gateway      = false
db_name                 = "ai_tos"
db_username             = "ai_tos"
db_instance_class       = "db.r6g.large"
db_allocated_storage    = 100
db_max_allocated_storage = 1000
db_max_connections      = 500
db_multi_az             = true
db_read_replica_count   = 1
db_read_replica_class   = "db.r6g.large"
db_backup_retention     = 14
db_backup_window        = "03:00-04:00"
db_maintenance_window   = "sun:05:00-sun:06:00"
db_performance_insights_retention = 7
db_monitoring_interval  = 60
db_deletion_protection  = true
db_skip_final_snapshot  = true
db_final_snapshot_identifier = ""
redis_cache_node_type   = "cache.r6g.large"
redis_cache_clusters    = 2
redis_state_node_type   = "cache.r6g.large"
redis_state_clusters    = 2
allowed_ingress_cidrs_state = []
