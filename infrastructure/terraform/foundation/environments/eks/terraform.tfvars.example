# Phase 0B.2 — EKS platform (self-contained example). Apply in the target account.
# In production, EKS is attached to the environment VPC (see foundation README); this
# standalone environment demonstrates the full VPC + EKS wiring and validates independently.
name                    = "ai-tos-prod"
environment             = "prod"
region                  = "us-east-1"
dr_region               = "us-west-2"
vpc_cidr                = "10.30.0.0/16"
public_subnets          = ["10.30.0.0/20", "10.30.16.0/20", "10.30.32.0/20"]
private_subnets         = ["10.30.64.0/20", "10.30.80.0/20", "10.30.96.0/20"]
database_subnets        = ["10.30.128.0/20", "10.30.144.0/20", "10.30.160.0/20"]
one_nat_gateway_per_az  = true
single_nat_gateway      = false
cluster_version         = "1.29"
public_endpoint_enabled = false   # private endpoint only; enable + set cidrs for break-glass/CI
public_endpoint_cidrs   = []
system_node_min        = 1
system_node_max        = 3
system_node_desired    = 2
app_node_min           = 2
app_node_max           = 10
app_node_desired       = 3
app_node_on_demand_base = 2
app_node_spot_percentage = 70
control_plane_log_retention = 30
