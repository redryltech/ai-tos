# AI-TOS environment example (copy to .env and adjust).
# Phase 0A foundation. No business logic / secrets here.
NODE_ENV=development
LOG_LEVEL=info

# API
PORT=4000
DATABASE_URL=postgresql://ai-tos:ai-tos@localhost:5432/ai_tos

# Redis (ADR-0005)
# Local dev uses a single Redis for convenience:
REDIS_URL=redis://localhost:6379
# Production uses split clusters (set these in deployed environments):
REDIS_CACHE_URL=redis://localhost:6379   # volatile cache / computed indicators / pub-sub
REDIS_STATE_URL=redis://localhost:6379   # sessions + rate limiting

# Event backbone (ADR-0004)
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Auth
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# AI Service
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
