{
  "name": "ai-tos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "postinstall": "node ./scripts/windows/materialize-native-bins.js",
    "windows:fix-bins": "node ./scripts/windows/materialize-native-bins.js",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^8.57.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "globals": "^15.9.0",
    "husky": "^9.1.4",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^7.18.0"
  },
  "pnpm": {
    "overrides": {
      "eslint": "8.57.1",
      "nanoid@^3": "3.3.17",
      "js-yaml": "^4.3.1",
      "minimatch@^9": "9.0.7",
      "multer": "^2.2.0",
      "picomatch@^4": "4.0.4",
      "lodash": "^4.18.0",
      "tmp": "^0.2.6",
      "glob@^10": "10.5.0",
      "postcss": "^8.5.18",
      "fast-uri": "^3.1.5",
      "sharp": "^0.35.0"
    }
  }
}
