{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (NestJS)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["-r", "ts-node/register", "apps/api/src/main.ts"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Web (Next.js)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["node_modules/.bin/next", "dev"],
      "cwd": "${workspaceFolder}/apps/web"
    }
  ]
}
